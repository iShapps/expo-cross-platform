{
  "cli": {
    "version": ">= 16.32.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "environment": "production",
      "env": {
        "APP_ENV": "production",
        "SENTRY_ORG": "truride",
        "SENTRY_PROJECT": "ishapps"
      }
    }
  },
  "submit": {
    "production": {}
  }
}

// eas update --branch production --environment production --message ""
