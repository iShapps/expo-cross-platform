{
  "expo": {
    "name": "iShapps",
    "slug": "ishapps",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/smhealth.png",
    "scheme": "ishapps",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow $(PRODUCT_NAME) to use Face ID for authentication.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.victorishapps.ishapps"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#70C601",
        "foregroundImage": "./assets/images/ishapps.png",
        "backgroundImage": "./assets/images/ishapps.png",
        "monochromeImage": "./assets/images/ishapps.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "package": "com.victorishapps.ishapps"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/smhealth.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/ishapps.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#70C601",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow $(PRODUCT_NAME) to access your Face ID biometric data."
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/inter/900Black/Inter_900Black.ttf"
          ]
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to use Face ID."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1e7bb57b-bac3-4d98-91c4-392a4bdbaeae"
      }
    }
  }
}
