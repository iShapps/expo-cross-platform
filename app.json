{
  "expo": {
    "name": "iShapps",
    "slug": "ishapps",
    "version": "2.8.0",
    "orientation": "portrait",
    "icon": "./assets/images/smhealth.png",
    "scheme": "ishapps",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "buildNumber": "28",
      "bundleIdentifier": "com.apporio.iShapps",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow $(PRODUCT_NAME) to use Face ID for authentication.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Allow $(PRODUCT_NAME) to access your location while using the app to navigate to assigned shift locations and verify arrival when starting or ending a shift.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow $(PRODUCT_NAME) to access your location in the background to monitor travel to assigned shift locations and verify presence at the facility when starting or ending a shift.",
        "UIBackgroundModes": ["location", "remote-notification"],
        "NSSupportsLiveActivities": true,
        "NSCalendarsUsageDescription": "Allow $(PRODUCT_NAME) to access your calendar to view and manage your scheduled shifts.",
        "NSRemindersUsageDescription": "Allow $(PRODUCT_NAME) to access your reminders to set shift-related reminders and notifications."
      },
      "entitlements": {
        "aps-environment": "production",
        "com.apple.security.application-groups": ["group.com.apporio.iShapps"]
      }
    },
    "android": {
      "versionCode": 28,
      "adaptiveIcon": {
        "backgroundColor": "#70C601",
        "foregroundImage": "./assets/images/smhealth.png",
        "backgroundImage": "./assets/images/smhealth.png",
        "monochromeImage": "./assets/images/smhealth.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ],
      "package": "com.ishapps.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/smhealth.png"
    },
    "plugins": [
      [
        "onesignal-expo-plugin",
        {
          "mode": "production"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4",
            "useFrameworks": "static"
          },
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24
          }
        }
      ],
      [
        "voltra",
        {
          "groupIdentifier": "group.com.apporio.iShapps",
          "enablePushNotifications": true
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to select images for document uploads.",
          "colors": {
            "cropToolbarColor": "#000000"
          },
          "dark": {
            "colors": {
              "cropToolbarColor": "#000000"
            }
          }
        }
      ],
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/ishapp-splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#70C601",
          "dark": {
            "backgroundColor": "#232A2E"
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow $(PRODUCT_NAME) to access your Face ID biometric data."
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/inter/900Black/Inter_900Black.ttf"
          ]
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to use Face ID."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location."
        }
      ],
      "expo-background-task",
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow $(PRODUCT_NAME) to access your calendar to view and manage your scheduled shifts.",
          "remindersPermission": "Allow $(PRODUCT_NAME) to access your reminders to set shift-related reminders and notifications."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "17a2649d-0933-4036-b23a-49012513cd96",
        "oneSignalAppId": "6eccb82b-f125-4deb-acb3-e85ed263de94",
        "oneSignalAndroidAppId": "6eccb82b-f125-4deb-acb3-e85ed263de94",
        "oneSignalIosAppId": "6eccb82b-f125-4deb-acb3-e85ed263de94"
      }
    },
    "owner": "ishapps"
  }
}
