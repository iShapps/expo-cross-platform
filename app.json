{
  "expo": {
    "name": "iShapps",
    "slug": "ishapps",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/smhealth.png",
    "scheme": "ishapps",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#70C601",
        "foregroundImage": "./assets/images/ishapps.png",
        "backgroundImage": "./assets/images/ishapps.png",
        "monochromeImage": "./assets/images/ishapps.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/smhealth.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/ishapps.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#70C601",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow iShapps to access your Face ID biometric data."
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/inter/900Black/Inter_900Black.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
